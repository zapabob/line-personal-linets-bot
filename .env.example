# Copy to .env or set these in your process manager. Do not commit real values.
LINEJS_PERSONAL_HOST=127.0.0.1
LINEJS_PERSONAL_PORT=9101
LINEJS_PERSONAL_DEVICE=DESKTOPWIN
LINEJS_PERSONAL_STORAGE=./linejs-storage.json

# Authentication: choose one method.
# LINEJS_PERSONAL_AUTH_TOKEN=
# LINEJS_PERSONAL_EMAIL=
# LINEJS_PERSONAL_PASSWORD=

# Optional legacy fallback gate. Leave disabled unless intentionally reusing LINE_PERSONAL_*.
LINEJS_PERSONAL_USE_LINE_PERSONAL_FALLBACK=0

# Auto-reply policy.
LINEJS_PERSONAL_AUTO_REPLY=1
LINEJS_PERSONAL_AUTO_REPLY_TRIGGERS=#はくあ,#hermesagent
LINEJS_PERSONAL_AUTO_REPLY_ONLY_GROUPS=1
LINEJS_PERSONAL_AUTO_REPLY_COOLDOWN_MS=5000
# LINEJS_PERSONAL_AUTO_REPLY_WEBHOOK=http://127.0.0.1:9102/reply
LINEJS_PERSONAL_AUTO_REPLY_WEBHOOK_TIMEOUT_MS=10000

# Optional allowlists. Use real MIDs only in your private environment, never in git.
# LINEJS_PERSONAL_ALLOWED_USERS=
# LINEJS_PERSONAL_ALLOWED_GROUP_MIDS=
# LINEJS_PERSONAL_GROUP_ADMIN_MIDS=
# LINEJS_PERSONAL_GROUP_BANLIST=./linejs-group-banlist.json
